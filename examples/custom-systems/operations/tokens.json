{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Operational control UI with independent roles and custom scale.",
  "navy": {
    "canvas": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.04313725,
          0.07058824,
          0.1254902
        ],
        "hex": "#0b1220"
      }
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.97254902,
          0.98039216,
          0.98823529
        ],
        "hex": "#f8fafc"
      }
    },
    "signal": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.13333333,
          0.82745098,
          0.93333333
        ],
        "hex": "#22d3ee"
      }
    }
  },
  "density": {
    "close": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "standard": {
      "$type": "dimension",
      "$value": {
        "value": 17,
        "unit": "px"
      }
    },
    "open": {
      "$type": "dimension",
      "$value": {
        "value": 36,
        "unit": "px"
      }
    }
  },
  "curves": {
    "elevated": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    }
  },
  "families": {
    "interface": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui"
      ]
    }
  },
  "states": {
    "callToAction": {
      "$value": "{navy.signal}"
    },
    "alertInk": {
      "$value": "{navy.ink}"
    }
  },
  "timings": {
    "quick": {
      "$type": "duration",
      "$value": {
        "value": 140,
        "unit": "ms"
      }
    }
  }
}
