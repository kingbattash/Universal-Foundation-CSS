{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A publication-specific design system. No shared UF-CSS visual defaults.",
  "paper": {
    "canvas": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.96862745,
          0.92941176
        ],
        "hex": "#fff7ed"
      }
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.16078431,
          0.14509804,
          0.14117647
        ],
        "hex": "#292524"
      }
    },
    "highlight": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.62352941,
          0.07058824,
          0.22352941
        ],
        "hex": "#9f1239"
      }
    }
  },
  "rhythm": {
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "reading": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "edge": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    }
  },
  "corners": {
    "sharp": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "typography": {
    "title": {
      "$type": "fontFamily",
      "$value": [
        "Georgia",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Charter",
        "serif"
      ]
    }
  },
  "roles": {
    "readingInk": {
      "$type": "color",
      "$value": "{paper.ink}"
    },
    "feature": {
      "$type": "color",
      "$value": "{paper.highlight}"
    }
  },
  "proportions": {
    "proseMeasure": {
      "$type": "number",
      "$value": 72
    }
  }
}
